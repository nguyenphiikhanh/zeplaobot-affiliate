{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,

        "baseUrl": ".",
        "paths": {
            "@/*": [
                "resources/js/src/*"
            ]
        },

        "types": [
            "vite/client"
        ]
    },

    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.vue",
        "resources/js/**/*.d.ts",
        "vite.config.ts"
    ]
}
